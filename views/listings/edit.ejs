<% layout('layout/boilerplate') -%>
<div class="row mt-3">
    <div class="col-6 offset-3">
        <h3>Edit a listing</h3>
        <form method="POST" action="/listings/<%=listing._id%>?_method=PUT" class="needs-validation" novalidate enctype="multipart/form-data">
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input type="text" name="listing[title]" id="title" value="<%=listing.title%>" class="form-control" required/>
                <div class="invalid-feedback">Title is required</div>
            </div>
            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea name="listing[description]" id="description" class="form-control" required><%=listing.description%></textarea>
                <div class="invalid-feedback">Description is required</div>
            </div>
            
            <div class="mb-3">
                <img src="<%= originalImageUrl%>" alt="img">
            </div>
            <div class="mb-3">
                <label for="image" class="form-label">Upload new Image </label>
                <input type="file" 
                       name="listing[image]" 
                       id="image" 
                       class="form-control" />
            </div>
            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="price" class="form-label">Price</label>
                    <input type="number" name="listing[price]" id="price" value="<%=listing.price%>" class="form-control" required/>
                    <div class="invalid-feedback">Price is required</div>
                </div>
                <div class="mb-3 col-md-4">
                    <label for="rentalType" class="form-label">Rental type</label>
                    <select name="listing[rentalType]" id="rentalType" class="form-select" required>
                        <option value="short-term" <%= (listing.rentalType || 'short-term') === 'short-term' ? 'selected' : '' %>>Short-term</option>
                        <option value="long-term" <%= (listing.rentalType || 'short-term') === 'long-term' ? 'selected' : '' %>>Long-term</option>
                    </select>
                </div>
                <div class="mb-3 col-md-4">
                    <label for="pricingUnit" class="form-label">Price unit</label>
                    <select name="listing[pricingUnit]" id="pricingUnit" class="form-select" required>
                        <option value="night" <%= (listing.pricingUnit || 'night') === 'night' ? 'selected' : '' %>>Night</option>
                        <option value="month" <%= (listing.pricingUnit || 'night') === 'month' ? 'selected' : '' %>>Month</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label for="country" class="form-label">Country</label>
                <input type="text" name="listing[country]" id="country" value="<%=listing.country%>" class="form-control" required/>
                <div class="invalid-feedback">Country is required</div>
            </div>

            <div class="mb-3">
                <label for="location" class="form-label">Location</label>
                <input type="text" name="listing[location]" id="location" value="<%=listing.location%>" class="form-control" required/>
                <div class="invalid-feedback">Location is required</div>
            </div>

            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="bedrooms" class="form-label">Bedrooms</label>
                    <input type="number" name="listing[bedrooms]" id="bedrooms" min="1" step="1" placeholder="Bedrooms" value="<%= listing.bedrooms ?? '' %>" class="form-control"/>
                </div>
                <div class="mb-3 col-md-4">
                    <label for="bathrooms" class="form-label">Bathrooms</label>
                    <input type="number" name="listing[bathrooms]" id="bathrooms" min="1" step="1" placeholder="Bathrooms" value="<%= listing.bathrooms ?? '' %>" class="form-control"/>
                </div>
                <div class="mb-3 col-md-4">
                    <label for="squareFeet" class="form-label">Sq ft</label>
                    <input type="number" name="listing[squareFeet]" id="squareFeet" min="1" step="1" placeholder="Square feet" value="<%= listing.squareFeet ?? '' %>" class="form-control"/>
                </div>
            </div>
           
            <div class="mb-3">
                <button class="btn btn-dark edit-btn">Save changes</button>
            </div>
        </form>
    </div>
</div>