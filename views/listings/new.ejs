<% layout("/layout/boilerplate") -%>

    <div class="row mt-3">
        <div class="col-6 offset-3">
        <h3>New listing</h3>
    <form action="/listings" method="POST" class="needs-validation" novalidate enctype="multipart/form-data">

        <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input type="text" name="listing[title]" id="title" placeholder="Enter the Title" class="form-control" required/>
        <div class="invalid-feedback">Title is required</div>
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
        <textarea name="listing[description]" id="description" placeholder="Description" class="form-control" required></textarea>
        <div class="invalid-feedback">Description is required</div>
        </div>


        <div class="mb-3">
            <label for="image" class="form-label">Upload Image</label>
        <input type="file" name="listing[image]" id="image" class="form-control" required/>
        <div class="invalid-feedback">Image is required</div>
        </div>

        <div class="row">
            <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price </label>
        <input  name="listing[price]" id="price" placeholder="Price" class="form-control" required/>
        <div class="invalid-feedback">Price is required</div>
        </div>

            <div class="mb-3 col-md-4">
                <label for="rentalType" class="form-label">Rental type</label>
                <select name="listing[rentalType]" id="rentalType" class="form-select" required>
                    <option value="short-term" selected>Short-term</option>
                    <option value="long-term">Long-term</option>
                </select>
            </div>

            <div class="mb-3 col-md-4">
                <label for="pricingUnit" class="form-label">Price unit</label>
                <select name="listing[pricingUnit]" id="pricingUnit" class="form-select" required>
                    <option value="night" selected>Night</option>
                    <option value="month">Month</option>
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label for="country" class="form-label">Country</label>
        <input type="text" name="listing[country]" id="country" placeholder="Country" class="form-control" required/>
        <div class="invalid-feedback">Country is required</div>
        </div>

        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
        <input type="text" name="listing[location]" id="location" placeholder="Location" class="form-control" required/>
        <div class="invalid-feedback">Location is required</div>
        </div>

        <div class="row">
            <div class="mb-3 col-md-4">
                <label for="bedrooms" class="form-label">Bedrooms</label>
                <input type="number" name="listing[bedrooms]" id="bedrooms" min="1" step="1" placeholder="Bedrooms" class="form-control"/>
            </div>
            <div class="mb-3 col-md-4">
                <label for="bathrooms" class="form-label">Bathrooms</label>
                <input type="number" name="listing[bathrooms]" id="bathrooms" min="1" step="1" placeholder="Bathrooms" class="form-control"/>
            </div>
            <div class="mb-3 col-md-4">
                <label for="squareFeet" class="form-label">Sq ft</label>
                <input type="number" name="listing[squareFeet]" id="squareFeet" min="1" step="1" placeholder="Square feet" class="form-control"/>
            </div>
        </div>

        <button class="btn btn-dark add-btn">Create Listing</button>
    </form>
    </div>
    </div>
