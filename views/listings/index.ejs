<% layout('layout/boilerplate') -%>
<body>
  <h3>All Listings</h3>
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 row-cols-vs-1">
    <% for(let listing of allListings) { %>
        <a href="/listings/<%=listing._id%>" class="listing-link">
            <div class="card" style="width: 18rem;">
      <img src="<%= (listing.image && listing.image.url) ? listing.image.url : listing.image %>" class="card-img-top" alt="listing image">
      <div class="card-img-overlay"></div>
      <div class="card-body">
        <p class="card-text"> <b> <%= listing.title %> </b><br><br> &#8377; <%= listing.price.toLocaleString("en-IN") %></p>
      </div>
     
    </div>
     <% } %>
        </a>
    
</div>


</body>
