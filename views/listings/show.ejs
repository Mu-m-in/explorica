<% layout("layout/boilerplate") -%>

<div class="container">
  <div class="row mt-3">
    <div class="col-12 col-md-8 offset-md-2">
      <h3 class="offset-1">Listing details: <%= listing.title %></h3>
      
      <div class="card">
        <img src="<%= (listing.image && listing.image.url) ? listing.image.url : listing.image %>" class="card-img-top" alt="Listing Image">
        <div class="card-body">
          <h5 class="card-title mt-3"><b><%= listing.title %></b></h5>
          <p class="card-text">
            <%= listing.description %><br>
            &#8377; <%= listing.price.toLocaleString("en-IN") %><br>
            <%= listing.location %>, <%= listing.country %>
          </p>
          <div class="d-flex justify-content-start gap-2">
            <a href="/listings/edit/<%= listing._id %>" class="btn btn-dark">Edit</a>
            <a href="/listings/delete/<%= listing._id %>?_method=DELETE" class="btn btn-dark">Delete</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

