<% layout("/layout/boilerplate") -%>
<body>
    <h3>Listing details : <%=listing.title%></h3>
    <ul>
        <li> <%=listing.description%> </li>
        <li> Price : &#8377; <%=listing.price.toLocaleString("en-IN")%></li>
        <li> Location : <%=listing.location%></li>
        <li> Country :<%=listing.country%></li>
         </ul>
        <form method="get" action="/listings/edit/<%=listing._id %>">
            <button>Edit listing</button>
        </form>
        <br><br>
        <form method="post" action="/listings/delete/<%=listing._id %>?_method=DELETE">
            <button>Delete listing</button>
        </form>
   
</body>
