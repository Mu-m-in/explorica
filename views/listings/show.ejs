<% layout('layout/boilerplate') -%>

<div class="container">
  <div class="row mt-3">
    <div class="col-12 col-md-8 offset-md-2">
      <div class="card">
        <img src="<%= (listing.image && listing.image.url) ? listing.image.url : listing.image %>" 
             class="card-img-top" 
             alt="Listing Image">
        <div class="card-body px-4">
          <h5 class="card-title mb-3"><%= listing.title %></h5>
          <p class="card-text">
            <%= listing.description %><br>
            <b>&#8377; <%= listing.price.toLocaleString("en-IN") %></b><br>
            <%= listing.location %>, <%= listing.country %>
          </p>
          <div class="d-flex gap-2">
            <a href="/listings/edit/<%= listing._id %>" class="btn btn-dark ed-btn">Edit</a>
            <form action="/listings/delete/<%= listing._id %>?_method=DELETE" method="POST" class="d-inline">
              <button class="btn btn-dark del-btn">Delete</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
