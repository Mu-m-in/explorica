<% layout('layout/boilerplate') -%>

<div class="container">
  <div class="row mt-3">
    <div class="col-12 col-md-8 offset-md-2">
      <div class="card">
        <h3><%= listing.title %></h3>
        <img src="<%=  listing.image.url %>" 
             class="card-img-top" 
             alt="Listing Image">
        <div class="card-body px-4">
          <p class="card-text mt-3">
            <p> Owned by <strong> <em> <%= listing.owner.username %> </em> </strong></p>
           <% const bedrooms = Number.isInteger(listing.bedrooms) && listing.bedrooms > 0 ? listing.bedrooms : "-"; %>
           <% const bathrooms = Number.isInteger(listing.bathrooms) && listing.bathrooms > 0 ? listing.bathrooms : "-"; %>
           <% const squareFeet = Number.isInteger(listing.squareFeet) && listing.squareFeet > 0 ? listing.squareFeet.toLocaleString("en-IN") : "-"; %>
           <div class="row row-cols-3 text-center my-4 listing-specifications">
             <div class="col">
               <i class="fa-solid fa-bed" aria-hidden="true"></i>
               <div class="fs-4 fw-semibold"><%= bedrooms %></div>
               <div class="text-muted">Bedrooms</div>
             </div>
             <div class="col">
               <i class="fa-solid fa-bath" aria-hidden="true"></i>
               <div class="fs-4 fw-semibold"><%= bathrooms %></div>
               <div class="text-muted">Bathrooms</div>
             </div>
             <div class="col">
               <i class="fa-solid fa-ruler-combined" aria-hidden="true"></i>
               <div class="fs-4 fw-semibold"><%= squareFeet %></div>
               <div class="text-muted">Sq ft</div>
             </div>
           </div>
           <p> <%= listing.description %> </p>
           <p class="card-text"> <b>&#8377; <%= listing.price.toLocaleString("en-IN") %></b></p>
           <p class="card-text"> <%= listing.location %>, <%= listing.country %> </p>
          </p>
          <% if(currUser && listing.owner._id.equals(currUser._id)) { %>
          <div class="d-flex gap-2">
            <a href="/listings/edit/<%= listing._id %>" class="btn btn-dark ed-btn">Edit</a>
            <form action="/listings/delete/<%= listing._id %>?_method=DELETE" method="POST" class="d-inline">
              <button class="btn btn-dark del-btn">Delete</button>
            </form>
          </div>
          
          <% } %>
        </div>
      </div>
      <% if(currUser) {%>
      <hr>
      <form action="/listings/<%=listing._id%>/reviews" method="post" class="needs-validation" novalidate>
        <div class="mt-3">
          <label for="rating" class="form-label">Rating</label>
          <fieldset class="starability-basic">
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>
        </div>
        <div class="mb-3">
          <label for="comment" class="form-label">Write a review</label>
          <textarea name="review[comment]" id="comment" class="form-control" rows="3" required placeholder="Leave a review"></textarea>
          <div class="invalid-feedback">Add a valid comment</div>
        </div>
        <div class="mb-3">
                <button class="btn btn-dark">Save review</button>
            </div> 
      </form>
      <% } %>
      <hr>
      <div class="mt-3">
        <h5>Reviews</h5>
          <div class="row">
             <% if(listing.reviews.length === 0){ %>
            <p>No reviews yet.</p>
        <% } else { %>
          
          <% for (let review of listing.reviews) { %>
            <div class="card col-5 ms-3 mb-2 border">
              <div class="card-body">
                <h4 class="card-title"> <%= review.author.username%></h4>
                    <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                  <p class="card-text"> <%=review.comment%></p>
              </div>
              <% if(currUser && review.author._id.equals(currUser._id)) { %>
              <form class="mb-3" method="post" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                <button class="btn btn-sm btn-dark">Delete</button>
              </form>
              <% }%>
            </div>
            <% } %>
            
            <% } %>
          </div>
      </div>
    </div>
  </div>
</div>
