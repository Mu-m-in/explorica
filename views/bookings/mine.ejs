<% layout('/layout/boilerplate') -%>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h3 class="mb-0">My bookings</h3>
    <a href="/listings" class="btn btn-outline-dark">Browse listings</a>
  </div>

  <% if (!bookings || bookings.length === 0) { %>
    <div class="alert alert-light border">No booking requests yet.</div>
  <% } else { %>
    <div class="booking-list">
      <% for (let booking of bookings) { %>
        <div class="card booking-item">
          <div class="row g-0 align-items-center">
            <div class="col-md-3">
              <% if (booking.listing && booking.listing.image && booking.listing.image.url) { %>
                <img src="<%= booking.listing.image.url %>" class="img-fluid booking-thumb" alt="<%= booking.listing.title %>">
              <% } %>
            </div>
            <div class="col-md-9">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                  <div>
                    <h5 class="mb-1"><%= booking.listing ? booking.listing.title : "Listing removed" %></h5>
                    <p class="mb-2 text-muted">
                      <%= booking.rentalType === "long-term" ? "Long-term rental" : "Short-term rental" %>
                      · <%= booking.priceUnit === "month" ? "Monthly" : "Nightly" %>
                    </p>
                  </div>
                  <span class="status-badge status-<%= booking.status %>"><%= booking.status %></span>
                </div>

                <div class="row g-3 mt-1">
                  <div class="col-md-6">
                    <p class="mb-1"><strong>Dates:</strong> <%= booking.startDate.toLocaleDateString("en-IN") %> to <%= booking.endDate.toLocaleDateString("en-IN") %></p>
                    <p class="mb-1"><strong>Duration:</strong> <%= booking.durationDays %> day(s)</p>
                    <p class="mb-1"><strong>Price snapshot:</strong> ₹<%= booking.priceSnapshot.toLocaleString("en-IN") %></p>
                  </div>
                  <div class="col-md-6">
                    <p class="mb-1"><strong>Estimated total:</strong> ₹<%= booking.estimatedTotal.toLocaleString("en-IN") %></p>
                    <p class="mb-1"><strong>Submitted:</strong> <%= booking.createdAt.toLocaleString("en-IN") %></p>
                    <% if (booking.respondedAt) { %>
                      <p class="mb-0"><strong>Response:</strong> <%= booking.respondedAt.toLocaleString("en-IN") %></p>
                    <% } %>
                  </div>
                </div>

                <% if (["pending", "approved"].includes(booking.status)) { %>
                  <form action="/bookings/<%= booking._id %>/cancel" method="POST" class="mt-3">
                    <button class="btn btn-outline-danger btn-sm">Cancel booking</button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>
</div>
