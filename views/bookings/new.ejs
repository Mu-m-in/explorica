<% layout('/layout/boilerplate') -%>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card booking-detail-card p-3 p-md-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
          <div>
            <p class="text-muted mb-1">Request to book</p>
            <h3 class="mb-0"><%= listing.title %></h3>
          </div>
          <div class="booking-price-inline">
            <span class="booking-price-value">₹<%= listing.price.toLocaleString("en-IN") %></span>
            <span class="booking-price-unit">/ <%= priceUnit === "month" ? "month" : "night" %></span>
          </div>
        </div>

        <div class="row g-3 align-items-center mb-3">
          <div class="col-md-4">
            <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="img-fluid booking-page-image">
          </div>
          <div class="col-md-8">
            <p class="mb-2"><strong>Location:</strong> <%= listing.location %>, <%= listing.country %></p>
            <p class="mb-2"><strong>Rental type:</strong> <%= rentalType === "long-term" ? "Long-term rental" : "Short-term rental" %></p>
            <p class="mb-0"><strong>Price snapshot:</strong> ₹<%= listing.price.toLocaleString("en-IN") %> <%= priceUnit === "month" ? "per month" : "per night" %></p>
          </div>
        </div>

        <form action="/bookings" method="POST" class="booking-form needs-validation" novalidate>
          <input type="hidden" name="booking[listingId]" value="<%= listing._id %>">
          <input type="hidden" name="booking[rentalType]" value="<%= rentalType %>">

          <div class="row g-3">
            <div class="col-md-6">
              <label for="startDate" class="form-label">Start date</label>
              <input type="date" name="booking[startDate]" id="startDate" class="form-control" min="<%= minDate %>" required>
              <div class="invalid-feedback">Start date is required.</div>
            </div>
            <div class="col-md-6">
              <label for="endDate" class="form-label">End date</label>
              <input type="date" name="booking[endDate]" id="endDate" class="form-control" min="<%= minDate %>" required>
              <div class="invalid-feedback">End date must be later than the start date.</div>
            </div>
          </div>

          <% if (rentalType === "short-term") { %>
            <div class="mt-3">
              <label for="guestCount" class="form-label">Guest count</label>
              <input type="number" name="booking[guestCount]" id="guestCount" class="form-control" min="1" max="20" value="2" required>
              <div class="invalid-feedback">Guest count is required.</div>
            </div>
          <% } %>

          <div class="mt-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="booking-summary-text">
              <% if (rentalType === "short-term") { %>
                Estimated nightly booking total is charged once the request is approved.
              <% } else { %>
                Estimated monthly rent is treated as a transparent estimate and does not include deposits, utilities, or extra fees.
              <% } %>
            </div>
            <button class="btn btn-dark add-btn">Request to Book</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
